# Copy to .env and adjust for local development.

# --- Application ---
HEALTHX_ENV=local
HEALTHX_LOG_LEVEL=INFO
HEALTHX_TIMEZONE=Asia/Kolkata

# Comma-separated list of allowed browser origins (the Next.js frontend).
HEALTHX_CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Async URL used by the API (psycopg 3 driver).
HEALTHX_DATABASE_URL=postgresql+psycopg://healthx:healthx@localhost:5432/healthx

# --- Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
HEALTHX_JWT_SECRET=change-me-in-every-environment
HEALTHX_JWT_ALGORITHM=HS256
HEALTHX_ACCESS_TOKEN_TTL_MINUTES=15
HEALTHX_REFRESH_TOKEN_TTL_MINUTES=10080

# --- Seed (scripts/seed.py) ---
HEALTHX_SEED_ADMIN_EMAIL=admin@healthx.example.com
HEALTHX_SEED_ADMIN_PASSWORD=change-me-now-please
HEALTHX_SEED_ADMIN_NAME=HealthX Admin
